---
import { Icon } from "astro-icon/components";
import type { Tool } from "../data/building";

const { name, kind, description, tags, links, detailHref } = Astro.props as Tool;

// Add an entry here to get a branded icon for a new link label.
// Anything not listed falls back to a generic link icon.
const iconFor: Record<string, string> = {
  GitHub: "simple-icons:github",
  npm: "simple-icons:npm",
  Web: "lucide:globe",
  "Chrome Store": "simple-icons:googlechrome",
};
---

<article class="tool-card">
  <div class="tool-card__head">
    <h3>{name}</h3>
    <span class="tool-card__kind">{kind}</span>
  </div>
  <p>{description}</p>
  <ul class="tool-card__tags">
    {tags.map((tag) => <li>#{tag}</li>)}
  </ul>
  <div class="tool-card__links">
    {links.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} title={link.label}>
        <Icon name={iconFor[link.label] ?? "lucide:link"} width="16" height="16" />
      </a>
    ))}
  </div>
  {detailHref && (
    <a class="tool-card__detail" href={detailHref}>How it's built &rarr;</a>
  )}
</article>

<style>
  .tool-card {
    background: var(--bg-raised);
    border: 1px solid var(--rule);
    border-radius: 8px;
    padding: 1.25rem 1.4rem;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .tool-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
  }
  .tool-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .tool-card__kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    background: var(--rule);
    border-radius: 20px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }
  .tool-card__tags {
    display: flex;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
  }
  .tool-card__links {
    display: flex;
    gap: 0.75rem;
    color: var(--accent-ink);
  }
  .tool-card__detail {
    display: inline-block;
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-ink);
    text-decoration: none;
  }
  .tool-card__detail:hover {
    text-decoration: underline;
  }
</style>