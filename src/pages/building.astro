---
import Layout from "../layouts/Layout.astro";
import ToolCard from "../components/ToolCard.astro";
import { openSourceTools, experimentTools, inProgress, decisions } from "../data/building";
---

<Layout title="Building" description="Tools and projects.">
  <h1>What I'm building</h1>
  <p class="page-intro">
    I like building small things to understand ideas. Some end up documented and published as open-source libraries. Others stay experiments — built to fix something I kept running into myself, and not much more polished than that.
  </p>

  <section class="tool-group">
    <h2 class="group-title">Open source</h2>
    <p class="group-note">Published, documented, meant for other people to actually use.</p>
    <div class="tool-grid">
      {openSourceTools.map((tool) => <ToolCard {...tool} />)}
    </div>
  </section>

  <section class="tool-group">
    <h2 class="group-title">Experiments</h2>
    <p class="group-note">Smaller, rougher, built mostly for myself. No writeups — just what they are and why they exist.</p>
    <div class="tool-grid">
      {experimentTools.map((tool) => <ToolCard {...tool} />)}
    </div>
  </section>

  <section class="tool-group">
    <h2 class="group-title">Decisions</h2>
    <ul class="decisions-list">
      {decisions.map((item) => (
        <li>
          <h3 class="decisions-list__title">{item.title}</h3>
          <p class="decisions-list__body">{item.body}</p>
          {item.href && <a href={item.href}>{item.linkLabel}</a>}
        </li>
      ))}
    </ul>
  </section>

  {inProgress.length > 0 && (
    <section class="in-progress">
      <p class="in-progress__label">Still in progress</p>
      <ul class="in-progress__list">
        {inProgress.map((item) => (
          <li>
            <div class="in-progress__head">
              <span class="in-progress__name">{item.name}</span>
              <span class="in-progress__kind">{item.kind}</span>
            </div>
            <p class="in-progress__desc">{item.description}</p>
            {item.href && (
              <a href={item.href} target="_blank" rel="noopener noreferrer">Open &rarr;</a>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</Layout>

<style>
  .page-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    margin-bottom: 2rem;
  }
  .tool-group {
    margin-bottom: 2.5rem;
  }
  .group-title {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
    border-left: 3px solid var(--accent);
    padding-left: 0.75rem;
    margin: 0 0 0.5rem;
  }
  .group-note {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
  }
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
  }
  .decisions-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .decisions-list li {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .decisions-list__title {
    font-size: 0.95rem;
    margin: 0 0 0.4rem;
  }
  .decisions-list__body {
    color: var(--ink-soft);
    margin: 0 0 0.5rem;
  }
  .decisions-list a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .in-progress {
    margin-top: 1rem;
  }
  .in-progress__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
  }
  .in-progress__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .in-progress__list li {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .in-progress__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .in-progress__name {
    font-family: var(--font-mono);
    font-weight: 700;
  }
  .in-progress__kind {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .in-progress__desc {
    margin: 0.3rem 0 0.4rem;
    color: var(--ink-soft);
  }
</style>