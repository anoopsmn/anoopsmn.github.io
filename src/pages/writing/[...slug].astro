---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
  const posts = (await getCollection("writing", ({ data }) => import.meta.env.DEV || !data.draft))
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      newerPost: posts[index - 1] ?? null,
      olderPost: posts[index + 1] ?? null,
    },
  }));
}

interface Props {
  post: CollectionEntry<"writing">;
  newerPost: CollectionEntry<"writing"> | null;
  olderPost: CollectionEntry<"writing"> | null;
}

const { post, newerPost, olderPost } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="post">
    <a href="/writing" class="back-link">&larr; Back to writing</a>
    <p class="eyebrow">
      {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
    </p>
    <h1>{post.data.title}</h1>
    {post.data.draft && <span class="draft-badge">Draft — not yet published</span>}
    <p class="post-description">{post.data.description}</p>
    {post.data.tags?.length > 0 && (
      <ul class="post-tags">
        {post.data.tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    )}
    <Content />
    <nav class="post-pager">
      {olderPost ? (
        <a href={`/writing/${olderPost.id}`} class="post-pager__link">
          <Icon name="lucide:arrow-left" width="16" height="16" />
          <span>
            <span class="post-pager__label">Older</span>
            <span class="post-pager__title" title={olderPost.data.title}>{olderPost.data.title}</span>
          </span>
        </a>
      ) : <span />}
      {newerPost ? (
        <a href={`/writing/${newerPost.id}`} class="post-pager__link post-pager__link--next">
          <span>
            <span class="post-pager__label">Newer</span>
            <span class="post-pager__title" title={newerPost.data.title}>{newerPost.data.title}</span>
          </span>
          <Icon name="lucide:arrow-right" width="16" height="16" />
        </a>
      ) : <span />}
    </nav>
    <a href="/writing" class="back-link back-link--bottom">&larr; Back to writing</a>
  </article>
</Layout>

<style>
  .post {
    max-width: 68ch;
  }

  .post :global(h2) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--accent-ink);
    text-transform: none;
    margin: 2.5em 0 0.6em;
  }

  .post-description {
    font-size: 1.1rem;
    color: var(--ink-soft);
    margin-bottom: 2rem;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .post-tags li {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-ink);
    background: var(--accent-soft);
    border-radius: 20px;
    padding: 0.3rem 0.7rem;
  }
  .back-link--bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .post-pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .post-pager__link {
    display: flex;
    align-items: stretch;
    gap: 0.6rem;
    padding: 1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }
  .post-pager__link:hover {
    border-color: var(--accent);
  }
  .post-pager__link--next {
    justify-content: flex-end;
    text-align: right;
  }
  .post-pager__label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--ink-faint);
    text-transform: uppercase;
  }
  .post-pager__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
  }
</style>