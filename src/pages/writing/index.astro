---
import Layout from "../../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import {getSortedPosts } from "../../lib/posts";

const posts = await getSortedPosts();
---

<Layout title="Writing">
  <h1>Writing</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={`/writing/${post.id}`}>
          <h2>{post.data.title}</h2>
        </a>
        {post.data.draft && <span class="draft-badge">Draft</span>}
        <p class="post-card__date">
          <Icon name="lucide:calendar" width="14" height="14" />
          {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "short", day: "numeric" })}
        </p>
        <p class="post-card__desc">{post.data.description}</p>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .post-card {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .post-card:last-child {
    border-bottom: none;
  }
  .post-card a {
    text-decoration: none;
  }
  .post-card a:hover h2 {
    color: var(--accent-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .post-card h2 {
    margin: 0 0 0.4rem;
  }
  .post-card__date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-faint);
    margin: 0 0 0.5rem;
  }
  .post-card__date svg {
    flex-shrink: 0;
  }
  .post-card__desc {
    margin: 0;
  }
</style>