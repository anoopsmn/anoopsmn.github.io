---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import EasterEgg from "../components/EasterEgg.astro";
import { getCollection } from "astro:content";
import { site } from "../config";
import { hero, timeline, focusAreas, buildingNowIntro, buildingNow } from "../data/home";

// Curated via each post's `featured` frontmatter flag, not a hardcoded
// slug list, so this section can't drift out of sync with the content.
// The /writing index page is unaffected: it always shows everything by
// recency.
const featuredPosts = await getCollection(
  "writing",
  ({ data }) => data.featured && (import.meta.env.DEV || !data.draft)
);
const posts = featuredPosts.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Layout title="Home">
  <div class="hero">
    <div class="hero__top">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="hero__line1">{hero.headlineLine1}</h1>
        <h1 class="hero__line2">{hero.headlineLine2}</h1>
      </div>
      <div class="hero__avatar-wrap">
        <div class="hero__avatar" id="hero-avatar">
          {hero.avatarImage ? (
            <img src={hero.avatarImage} alt={site.name} />
          ) : (
            <span>{hero.initials}</span>
          )}
        </div>
        <EasterEgg />
      </div>
    </div>
    <p class="hero__lede">{hero.lede}</p>
  </div>

  <div class="tiles">
    <a class="tile tile--a" href="/building">
      <span class="tile__label">Building</span>
      <span class="tile__body">{hero.buildingTileText}</span>
    </a>
    <a class="tile tile--b" href="/writing">
      <span class="tile__label">Writing</span>
      <span class="tile__body">{hero.writingTileText}</span>
    </a>
  </div>

  <div class="focus">
    <p class="focus__label">Focus areas</p>
    <div class="focus__pills">
      {focusAreas.map((area) => <span class="pill">{area}</span>)}
    </div>
  </div>

  <h2>Journey</h2>
  <Timeline items={timeline} />
  <a href="/about#journey" class="journey-link">View the full journey &rarr;</a>

  <section class="building-now">
    <h2>Building now</h2>
    <p class="section-intro">{buildingNowIntro}</p>
    <ul class="building-now__list">
      {buildingNow.map((item) => (
        <li>
          <div class="building-now__head">
            <a href={item.href}>{item.name}</a>
            <span class="building-now__badge">{item.badge}</span>
          </div>
          <p class="building-now__desc">{item.description}</p>
        </li>
      ))}
    </ul>
    <a href="/building" class="see-more">View everything I'm building &rarr;</a>
  </section>

    {posts.length > 0 && (
      <section class="recent-writing">
        <div class="recent-writing__head">
          <h2>Recent writing</h2>
          <a href="/writing">All posts &rarr;</a>
        </div>
        <ul class="recent-writing__list">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}`}>{post.data.title}</a>
              <span class="recent-writing__desc"> — {post.data.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
</Layout>

<style>
  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hero__line1 {
    margin: 0.4rem 0 0;
  }
  .hero__line2 {
    margin: 0 0 1rem;
    color: var(--rule-strong);
  }
  .hero__avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .hero__avatar {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: var(--accent);
		color: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.7rem;
		overflow: hidden;
		border: 3px solid var(--bg-raised);
		box-shadow: 0 0 0 2px var(--accent), 0 4px 16px rgba(0, 0, 0, 0.12);
	}
  .hero__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__lede {
    max-width: 46ch;
  }

	@media (max-width: 640px) {
		.hero__top {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
		.hero__avatar {
			width: 88px;
			height: 88px;
			font-size: 1.3rem;
		}
	}
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .tile:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }
  .tile--a {
    background: var(--accent-soft);
  }
  .tile--b {
    background: var(--accent-soft-2);
  }
  .tile__label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--accent-ink);
  }
  .focus {
    margin-bottom: 2rem;
  }
  .focus__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .focus__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .journey-link {
    display: inline-block;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .building-now {
    margin-top: 3rem;
  }
  .section-intro {
    color: var(--ink-soft);
    max-width: 60ch;
    margin: 0.75rem 0 1.5rem;
  }
  .building-now__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .building-now__list li {
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }
  .building-now__list li:first-child {
    border-top: none;
    padding-top: 0;
  }
  .building-now__head {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .building-now__head a {
    font-weight: 600;
  }
  .building-now__badge {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .building-now__desc {
    margin: 0.3rem 0 0;
    color: var(--ink-soft);
  }
  .see-more {
    display: inline-block;
    margin-top: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .recent-writing {
  margin-top: 3rem;
}
.recent-writing__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.recent-writing__head a {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  white-space: nowrap;
}
.recent-writing__list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.recent-writing__list a {
  font-weight: 600;
}
.recent-writing__desc {
  color: var(--ink-soft);
}
</style>