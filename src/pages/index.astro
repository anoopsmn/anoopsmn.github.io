---
import Layout from "../layouts/Layout.astro";
import Timeline from "../components/Timeline.astro";
import { getCollection } from "astro:content";
import { getSortedPosts} from "../lib/posts";
import { site, hero, timeline, focusAreas } from "../config";

const posts =  (await getSortedPosts()).slice(0, 3);
---

<Layout title="Home">
  <div class="hero">
    <div class="hero__top">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 class="hero__line1">{hero.headlineLine1}</h1>
        <h1 class="hero__line2">{hero.headlineLine2}</h1>
      </div>
      <div class="hero__avatar">
        {hero.avatarImage ? (
          <img src={hero.avatarImage} alt={site.name} />
        ) : (
          <span>{hero.initials}</span>
        )}
      </div>
    </div>
    <p class="hero__lede">{hero.lede}</p>
  </div>

  <div class="tiles">
    <a class="tile tile--a" href="/building">
      <span class="tile__label">Building</span>
      <span class="tile__body">{hero.buildingTileText}</span>
    </a>
    <a class="tile tile--b" href="/writing">
      <span class="tile__label">Writing</span>
      <span class="tile__body">{hero.writingTileText}</span>
    </a>
  </div>

  <div class="focus">
    <p class="focus__label">Focus areas</p>
    <div class="focus__pills">
      {focusAreas.map((area) => <span class="pill">{area}</span>)}
    </div>
  </div>

  <h2>Journey</h2>
  <Timeline items={timeline} />
    {posts.length > 0 && (
      <section class="recent-writing">
        <div class="recent-writing__head">
          <h2>Recent writing</h2>
          <a href="/writing">All posts &rarr;</a>
        </div>
        <ul class="recent-writing__list">
          {posts.map((post) => (
            <li>
              <a href={`/writing/${post.id}`}>{post.data.title}</a>
              <span class="recent-writing__desc"> — {post.data.description}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
</Layout>

<style>
  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .hero__line1 {
    margin: 0.4rem 0 0;
  }
  .hero__line2 {
    margin: 0 0 1rem;
    color: var(--rule-strong);
  }
  .hero__avatar {
		width: 120px;
		height: 120px;
		border-radius: 50%;
		background: var(--accent);
		color: var(--bg);
		display: flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono);
		font-weight: 700;
		font-size: 1.7rem;
		flex-shrink: 0;
		overflow: hidden;
		border: 3px solid var(--bg-raised);
		box-shadow: 0 0 0 2px var(--accent), 0 4px 16px rgba(0, 0, 0, 0.12);
	}
  .hero__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__lede {
    max-width: 46ch;
  }

	@media (max-width: 640px) {
		.hero__top {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}
		.hero__avatar {
			width: 88px;
			height: 88px;
			font-size: 1.3rem;
		}
	}
  .tiles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.25rem 1.4rem;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, filter 0.15s ease;
  }
  .tile:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }
  .tile--a {
    background: var(--accent-soft);
  }
  .tile--b {
    background: var(--accent-soft-2);
  }
  .tile__label {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    color: var(--accent-ink);
  }
  .focus {
    margin-bottom: 2rem;
  }
  .focus__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-faint);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .focus__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .recent-writing {
  margin-top: 3rem;
}
.recent-writing__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 1rem;
}
.recent-writing__head a {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  white-space: nowrap;
}
.recent-writing__list {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.recent-writing__list a {
  font-weight: 600;
}
.recent-writing__desc {
  color: var(--ink-soft);
}
</style>